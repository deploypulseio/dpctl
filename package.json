{
  "name": "@deploypulseio/dpctl",
  "version": "1.0.0",
  "description": "Management CLI for the DeployPulse CodePush service",
  "main": "./bin/script/cli.js",
  "scripts": {
    "start": "node ./bin/script/cli.js",
    "clean": "rimraf bin",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "prettier": "prettier --write \"./**/*.ts\"",
    "lint": "npx eslint ./script/**/*.ts",
    "lint:fix": "npx eslint ./script/**/*.ts --fix"
  },
  "bin": {
    "dpctl": "./bin/script/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deploypulseio/dpctl.git"
  },
  "homepage": "https://github.com/deploypulseio/dpctl#readme",
