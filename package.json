    "url": "https://github.com/deploypulseio/dpctl/issues",
    "email": "support@deploypulse.io"
  },
  "files": [
    "bin/**",
    "README.md",
    "LICENSE*",
    "NOTICE"
  ],
  "author": "DeployPulse",
  "license": "Apache-2.0",
  "publishConfig": { 
