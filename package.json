    "q": "~1.5.1",
    "recursive-fs": "2.1.0",
    "rimraf": "^6.1.2",
    "semver": "^7.7.3",
    "simctl": "^3.0.0",
    "slash": "1.0.0",
    "superagent": "^10.2.3",
    "which": "^6.0.0",
    "wordwrap": "1.0.0",
    "xml2js": "^0.6.2",
    "yargs": "^17.7.2",
    "yazl": "^3.3.1"
  },
